---
interface Props {
  stage: number;
}
const { stage } = Astro.props;
---

<svg
  class="process-illustration"
  viewBox="0 0 96 96"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <rect x="5" y="9" width="82" height="78" rx="23" fill="#f0e8f8"></rect>
  <g stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
    {
      stage === 0 && (
        <>
          <path d="M37 28l3-13h20l3 13M37 68l3 13h20l3-13" fill="#ded0f0" />
          <rect x="28" y="28" width="44" height="40" rx="12" fill="#fcfafd" />
          <path d="M50 57c-3-4-8-8-8-13a8 8 0 0 1 16 0c0 5-5 9-8 13Z" />
          <circle cx="50" cy="44" r="2.5" fill="currentColor" stroke="none" />
          <path d="M17 37a23 23 0 0 0 0 23M10 32a32 32 0 0 0 0 33M79 42v12" opacity=".5" />
        </>
      )
    }
    {
      stage === 1 && (
        <>
          <path d="M19 22v51h58" opacity=".35" />
          <path d="M25 51c9 0 8-17 18-17s7 25 18 25 8-13 17-13" stroke-width="9" stroke="#dfd1f0" />
          <path d="M25 51c9 0 8-17 18-17s7 25 18 25 8-13 17-13" />
          <path
            d="M25 61c9 0 8-17 18-17s7 25 18 25 8-13 17-13"
            stroke-dasharray="2 5"
            opacity=".45"
          />
          <circle cx="43" cy="34" r="4" fill="#fcfafd" />
          <circle cx="61" cy="59" r="4" fill="#fcfafd" />
        </>
      )
    }
    {
      stage === 2 && (
        <>
          <path d="M17 59h62M17 36h62" stroke-dasharray="2 5" opacity=".3" />
          <path d="M17 48h15l8-8 9 18 12-34 10 24h8" />
          <circle cx="61" cy="24" r="9" fill="#e2d3f5" stroke="none" />
          <circle cx="61" cy="24" r="3" fill="currentColor" stroke="none" />
          <path d="M17 76h15M38 76h9M53 76h26" opacity=".4" />
        </>
      )
    }
    {
      stage === 3 && (
        <>
          <rect x="26" y="18" width="52" height="54" rx="9" fill="#ded0f0" stroke="none" />
          <rect x="18" y="26" width="52" height="54" rx="9" fill="#fcfafd" />
          <circle cx="43" cy="44" r="8" />
          <path d="M43 39v5l4 2M29 63h26M29 69h16" opacity=".65" />
          <circle cx="71" cy="71" r="13" fill="#eee3fc" />
          <path d="M64 72l5 5 9-11" />
        </>
      )
    }
    {
      stage === 4 && (
        <>
          <rect x="16" y="22" width="64" height="49" rx="10" fill="#fcfafd" />
          <circle cx="35" cy="40" r="6" />
          <path d="M24 58a11 11 0 0 1 22 0M54 38h14M54 45h10M54 56h14" opacity=".65" />
          <path d="M40 80h16M48 71v9" />
          <circle cx="76" cy="25" r="11" fill="#ded0f0" stroke="none" />
          <path d="M71 25l3 3 6-7" />
        </>
      )
    }
  </g>
</svg>
