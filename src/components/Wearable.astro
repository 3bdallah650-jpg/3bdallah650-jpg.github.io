---
import type { Locale } from '../content/schema';
import { assets } from '../data/assets';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const ar = locale === 'ar';
const signals = ar
  ? [
      ['الموقع', 'المكان ووقت آخر تحديث'],
      ['الاستغاثة', 'طلب مساعدة يرسله الشخص'],
      ['الحركة', 'تغيّر النشاط وإشارة سقوط محتمل'],
      ['نبض القلب وHRV', 'بيانات إضافية إذا أتاحها الجهاز'],
      ['الاتصال', 'هل وصلت الإشارة أم انقطعت؟'],
      ['الجهاز والبطارية', 'هل الجهاز يعمل وقابل للاتصال؟'],
    ]
  : [
      ['Location', 'Place and time of the last update'],
      ['SOS', 'A request for help sent by the person'],
      ['Motion', 'Activity change and a possible fall signal'],
      ['Heart rate / HRV', 'Additional data if the device provides it'],
      ['Connectivity', 'Did the signal arrive or stop?'],
      ['Device / battery', 'Is the device running and connected?'],
    ];
---

<section
  class="wearable-section section"
  id="wearable"
  aria-labelledby="wearable-title"
  data-wearable
>
  <div class="container wearable-heading">
    <div>
      <p class="eyebrow">{ar ? 'تجربة الجهاز المستهدفة' : 'The planned wearable experience'}</p>
      <h2 id="wearable-title">
        {
          ar
            ? 'الساعة ترصد الإشارات. وسام يربطها بروتين الشخص.'
            : 'The watch senses. WISAM adds personal context.'
        }
      </h2>
    </div>
    <p>
      {
        ar
          ? 'يمكن لجهاز قابل للارتداء أن يوفّر الموقع والحركة والنبض وطلب الاستغاثة وحالة الاتصال. دور وسام هو قراءة ما يتاح من هذه الإشارات معًا، وإظهار ما تغيّر عن المعتاد وما انقطع وصوله.'
          : 'A wearable can provide location, movement, heart-rate, SOS, and connection signals. WISAM’s role is to read what is available together, show what changed from the usual pattern, and make interruptions visible.'
      }
    </p>
  </div>
  <div class="wearable-scroll-stage" data-wearable-scroll>
    <div class="container wearable-stage">
      <div class="wearable-callouts wearable-callouts-start">
        {
          signals.slice(0, 3).map(([title, body], i) => (
            <div class="wearable-callout" data-wearable-callout={i}>
              <>
                <span class="callout-number">0{i + 1}</span>
                <strong>{title}</strong>
                <small>{body}</small>
              </>
            </div>
          ))
        }
      </div>
      <figure class="wearable-figure">
        <div class="watch-halo" aria-hidden="true"></div>
        <div class="watch-frames" data-watch-frames>
          <img
            class="watch-frame"
            src={assets.wearableConcept.filename}
            width="1000"
            height="1100"
            loading="lazy"
            decoding="async"
            alt={ar
              ? 'تصور أصلي لساعة ذكية محايدة سداسية الشكل، مخصص لشرح تجربة WISAM المستهدفة'
              : 'Original neutral six-sided smartwatch concept visualizing the planned WISAM wearable experience'}
          />
          <img
            class="watch-frame"
            data-watch-src={assets.wearableFront.filename}
            width="1000"
            height="1100"
            alt=""
            aria-hidden="true"
            decoding="async"
          />
          <img
            class="watch-frame"
            data-watch-src={assets.wearableThreeQuarter.filename}
            width="1000"
            height="1100"
            alt=""
            aria-hidden="true"
            decoding="async"
          />
          <img
            class="watch-frame"
            data-watch-src={assets.wearableSide.filename}
            width="1000"
            height="1100"
            alt=""
            aria-hidden="true"
            decoding="async"
          />
          <img
            class="watch-frame"
            data-watch-src={assets.wearableBack.filename}
            width="1000"
            height="1100"
            alt=""
            aria-hidden="true"
            decoding="async"
          />
        </div>
        <div class="watch-frame-status" aria-hidden="true">
          <span data-watch-counter dir="ltr">01 / 05</span>
          <span>{ar ? 'مرّر لاستكشاف الزوايا' : 'Scroll to explore the form'}</span>
          <i></i>
        </div>
        <figcaption>
          {
            ar
              ? 'تصور بصري لتجربة مستقبلية · إشارات النموذج الحالي مُحاكاة · ربط جهاز فعلي هو الخطوة التالية'
              : 'Future experience concept · current prototype signals are simulated · physical-device integration comes next'
          }
        </figcaption>
      </figure>
      <div class="wearable-callouts wearable-callouts-end">
        {
          signals.slice(3).map(([title, body], i) => (
            <div class="wearable-callout" data-wearable-callout={i + 3}>
              <>
                <span class="callout-number">0{i + 4}</span>
                <strong>{title}</strong>
                <small>{body}</small>
              </>
            </div>
          ))
        }
      </div>
    </div>
  </div>
  <div class="container wearable-outro">
    <span class="wearable-route" aria-hidden="true"><i></i><i></i><i></i></span>
    <p>
      {
        ar
          ? 'إشارات الجهاز ← مقارنة بما هو معتاد ← فحص السلامة ← معلومات يراجعها مقدّم الرعاية'
          : 'Device signals → comparison with routine → safety checks → caregiver review'
      }
    </p>
    <a href={ar ? '/ar/evidence/' : '/evidence/'}
      >{ar ? 'ما الذي اختُبر فعليًا؟' : 'What has actually been evaluated?'}
      <span aria-hidden="true">↗</span></a
    >
  </div>
</section>

<style>
  .wearable-section {
    background: #f0ebf6;
    color: #29242e;
    overflow: clip;
  }
  .wearable-heading {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 8%;
    align-items: end;
  }
  .wearable-heading h2 {
    max-width: 760px;
    margin: 0;
  }
  .wearable-heading > p {
    font-size: 1.16rem;
    line-height: 1.7;
    max-width: 470px;
    color: #514b56;
    margin: 0 0 9px;
  }
  .wearable-scroll-stage {
    height: 230svh;
    position: relative;
  }
  .wearable-stage {
    display: grid;
    grid-template-columns: 0.9fr minmax(390px, 1.8fr) 0.9fr;
    gap: 24px;
    align-items: center;
    min-height: 100svh;
    position: sticky;
    top: 0;
  }
  .wearable-callouts {
    display: grid;
    gap: 32px;
    position: relative;
    z-index: 2;
  }
  .wearable-callout {
    position: relative;
    display: grid;
    grid-template-columns: 30px 1fr;
    column-gap: 12px;
    border-top: 1px solid rgba(57, 43, 68, 0.28);
    padding-top: 14px;
    transition:
      transform 0.4s ease,
      border-color 0.4s ease;
  }
  .wearable-callout::after {
    content: '';
    position: absolute;
    inset-block-start: -1px;
    inset-inline-start: 0;
    width: 100%;
    height: 2px;
    background: #7e49b7;
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.4s ease;
  }
  :global(html[dir='rtl']) .wearable-callout::after {
    transform-origin: right center;
  }
  .wearable-callout.is-active::after,
  .wearable-callout.is-passed::after {
    transform: scaleX(1);
  }
  :global(html.motion-ready) .wearable-callout:not(.is-active):not(.is-passed) {
    transform: translateY(8px);
  }
  .wearable-callout.is-active {
    border-color: #7e49b7;
  }
  .wearable-callout.is-active strong {
    color: #502781;
  }
  .wearable-callout strong,
  .wearable-callout small {
    grid-column: 2;
  }
  .wearable-callout strong {
    font-size: 1.08rem;
  }
  .wearable-callout small {
    color: #5c5660;
    line-height: 1.5;
    margin-top: 4px;
    font-size: 0.85rem;
  }
  .callout-number {
    grid-row: 1/3;
    color: #633899;
    font-size: 0.76rem;
    font-weight: 700;
  }
  .wearable-figure {
    margin: 0;
    min-width: 0;
    position: relative;
    display: grid;
    place-items: center;
    isolation: isolate;
  }
  .watch-frames {
    position: relative;
    width: min(100%, 610px);
    aspect-ratio: 10 / 11;
    filter: drop-shadow(0 25px 30px rgba(36, 25, 44, 0.2));
    transform: translateY(var(--watch-stage-y, 0px)) scale(var(--watch-stage-scale, 1));
  }
  .watch-frame {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    opacity: 0;
    transform: translateX(2%) scale(0.96);
    transition:
      opacity 90ms linear,
      transform 250ms ease;
    will-change: opacity, transform;
  }
  .watch-frame:first-child {
    opacity: 1;
    transform: none;
  }
  .watch-frame-status {
    width: min(80%, 440px);
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px 16px;
    color: var(--brand-deep);
    font-size: 0.73rem;
    font-weight: 700;
  }
  .watch-frame-status i {
    width: 100%;
    height: 2px;
    background: linear-gradient(
      90deg,
      var(--brand) var(--watch-progress, 0%),
      #d5c4e7 var(--watch-progress, 0%)
    );
  }
  .watch-halo {
    position: absolute;
    width: 75%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, #d4c3ee 0%, #e5dcf0 45%, transparent 72%);
    filter: blur(12px);
    z-index: -1;
  }
  .wearable-figure figcaption {
    position: relative;
    text-align: center;
    margin-top: 12px;
    font-size: 0.73rem;
    line-height: 1.5;
    color: #59525e;
    max-width: 420px;
  }
  .wearable-outro {
    border-top: 1px solid rgba(57, 43, 68, 0.2);
    display: flex;
    align-items: center;
    gap: 30px;
    padding-top: 26px;
  }
  .wearable-outro p {
    margin: 0;
    flex: 1;
    font-weight: 600;
  }
  .wearable-outro a {
    font-weight: 700;
    color: #60349b;
    text-decoration: underline;
    text-underline-offset: 5px;
  }
  .wearable-route {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .wearable-route i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #7041a8;
  }
  .wearable-route i:not(:last-child)::after {
    content: '';
    display: block;
    position: relative;
    left: 8px;
    top: 3px;
    width: 13px;
    height: 2px;
    background: #bfaed4;
  }
  html[dir='rtl'] .wearable-route i:not(:last-child)::after {
    left: auto;
    right: 8px;
  }
  @media (max-width: 900px) {
    .wearable-scroll-stage {
      height: auto;
    }
    .wearable-stage {
      grid-template-columns: 1fr 1fr;
      min-height: 0;
      position: relative;
      top: auto;
      gap: 20px;
      margin-top: 32px;
    }
    .wearable-figure {
      grid-column: 1/-1;
      grid-row: 1;
    }
    .watch-frames {
      max-width: 510px;
      transform: none;
    }
    .watch-frame:not(:first-child),
    .watch-frame-status {
      display: none;
    }
    :global(html.motion-ready) .wearable-callout:not(.is-active),
    :global(html.motion-ready) .wearable-callout.is-passed {
      transform: none;
    }
    .wearable-heading {
      grid-template-columns: 1fr;
      gap: 25px;
    }
    .wearable-callouts {
      align-self: start;
    }
    .wearable-callout {
      min-height: 82px;
    }
    .wearable-outro {
      flex-wrap: wrap;
    }
  }
  @media (max-width: 560px) {
    .wearable-stage {
      display: block;
    }
    .wearable-figure {
      margin: 10px 0 30px;
    }
    .wearable-callouts {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 18px;
    }
    .wearable-callout {
      display: block;
      min-height: 0;
    }
    .wearable-callout strong,
    .wearable-callout small {
      display: block;
    }
    .callout-number {
      display: block;
      margin-bottom: 8px;
    }
    .wearable-outro {
      display: block;
    }
    .wearable-outro p {
      margin: 18px 0;
    }
    .wearable-heading > p {
      font-size: 1rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .wearable-scroll-stage {
      height: auto;
    }
    .wearable-stage {
      position: relative;
      min-height: 0;
    }
    .watch-frame:not(:first-child),
    .watch-frame-status {
      display: none;
    }
    .watch-frame:first-child {
      opacity: 1 !important;
      transform: none !important;
    }
    .watch-frames {
      transform: none;
    }
    .wearable-callout {
      transition: none !important;
      transform: none !important;
    }
    .wearable-callout::after {
      transition: none !important;
    }
  }
</style>
