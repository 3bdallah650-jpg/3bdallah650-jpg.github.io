---
import type { SiteContent } from '../content/schema';
interface Props {
  content: SiteContent;
}
const { content: c } = Astro.props;
const contactHref = `mailto:wisam.sa.2030@gmail.com?subject=${encodeURIComponent(c.locale === 'ar' ? 'استفسار عن WISAM' : 'WISAM General Inquiry')}`;
const items = [
  [c.privacyPage.collectTitle, c.privacyPage.collect],
  [c.privacyPage.analyticsTitle, c.privacyPage.analytics],
  [c.privacyPage.contactTitle, c.privacyPage.contact],
  [c.privacyPage.limitsTitle, c.privacyPage.limits],
];
---

<section class="page-intro">
  <div class="container narrow">
    <p class="eyebrow">WISAM / {c.footer.privacy}</p><h1>{c.privacyPage.title}</h1><p
      class="page-lead"
    >
      {c.privacyPage.lead}
    </p>
  </div>
</section>
<section class="section privacy-content">
  <div class="container narrow">
    <div class="privacy-list">
      {
        items.map(([title, body], i) => (
          <section>
            <>
              <span class="index">0{i + 1}</span>
              <div>
                <>
                  <h2>{title}</h2>
                  <p>{body}</p>
                  {i === 2 && (
                    <a class="text-link" href={contactHref}>
                      wisam.sa.2030@gmail.com <span aria-hidden="true">↗</span>
                    </a>
                  )}
                </>
              </div>
            </>
          </section>
        ))
      }
    </div>
  </div>
</section>
